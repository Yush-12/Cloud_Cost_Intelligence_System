# Cloud Cost Intelligence System — FinOps Simulation Engine
# Zero-cost in-memory simulation engine: no AWS API calls or credentials needed.

AWS_REGION=us-east-1

# Simulated Table Names (defaults used if omitted)
DYNAMODB_TABLE=CostTelemetry
ANOMALY_TABLE=AnomalyEvents
AUDIT_TABLE=OptimizationAudit

# Application Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
PIPELINE_INTERVAL_SECONDS=900

# Anomaly Detection & Optimization Thresholds
CONFIDENCE_THRESHOLD=0.85
MAX_ACTIONS_PER_HOUR=5
