# Operation Mode (true = 100% free simulated AWS data, zero AWS API calls, zero cost; false = live AWS)
SIMULATION_MODE=true

# AWS Configuration (only required if SIMULATION_MODE=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here


# DynamoDB Table Names (defaults used if omitted)
DYNAMODB_TABLE=CostTelemetry
ANOMALY_TABLE=AnomalyEvents
AUDIT_TABLE=OptimizationAudit

# Optional: Custom DynamoDB Endpoint (e.g. for DynamoDB Local or Docker)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Application Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
PIPELINE_INTERVAL_SECONDS=900

# Anomaly Detection & Optimization Thresholds
CONFIDENCE_THRESHOLD=0.85
MAX_ACTIONS_PER_HOUR=5
